# Copy this file to `keystore.properties` (same folder) and fill in your real
# values. `keystore.properties` and *.jks are gitignored — never commit them.
#
# 1. Create your upload key (run once, keep the .jks file + passwords safe forever):
#    keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 9125 -alias upload
# 2. Put upload-keystore.jks in the android/ folder (next to this file).
# 3. Fill in the values below.

storeFile=../upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
